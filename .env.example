# Copy to .env and set your camera details. Never commit .env.
CAMERA_IP=192.168.1.50
CAMERA_USERNAME=admin
CAMERA_PASSWORD=your_camera_password
CAMERA_RTSP_PORT=554
CAMERA_RTSP_PATH_TEMPLATE=/Streaming/Channels/{channel}

RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=5000
RTSP_READ_FAILURES_BEFORE_RECONNECT=10
RTSP_RECONNECT_DELAY_SECONDS=2
RECORDING_FPS=20
RECORDING_READ_RETRY_SLEEP_SECONDS=0.05
# Shorter intervals increase CPU use. Benchmark on the target Pi.
DETECTION_INTERVAL_SECONDS=0.5
# Learn the background after each connection before triggering a clip.
MOTION_WARMUP_SECONDS=5
# Motion method: difference (experimental) or background (original).
MOTION_ALGORITHM=difference
# Compressed per-camera pre-trigger buffer, sampled at 4 frames/s, max 5 MiB.
MOTION_PREROLL_SECONDS=3
# Compare experimental frame differences in logs; never affects recording.
MOTION_SHADOW_ENABLED=false
# Stop new clips at either limit; existing footage is never deleted automatically.
MOTION_MAX_CLIPS=500
MOTION_MIN_FREE_MB=2048
# Experimental shared person / moving-vehicle detection; requires ultralytics and models/yolo11n.pt.
OBJECT_DETECTION_ENABLED=false
